{
  "expo": {
    "name": "MSAS FarmAI",
    "slug": "msas-livestock-agro",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/branding/android/ic_launcher_standalone.png",
    "scheme": "farmai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmai.diagnostic",
      "icon": "./assets/branding/ios/AppIcon-1024.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MSAS FarmAI uses your microphone to convert your spoken questions into text for the AI Farm Assistant.",
        "NSSpeechRecognitionUsageDescription": "MSAS FarmAI uses speech recognition to understand your questions and provide agricultural assistance."
      }
    },
    "android": {
      "versionCode": 16,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/android/ic_launcher_foreground.png",
        "monochromeImage": "./assets/branding/android/ic_launcher_monochrome.png",
        "backgroundColor": "#0A3720"
      },
      "package": "com.msas.livestock",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/branding/web/favicon-512.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class expo.modules.** { *; }"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FarmAI to access your camera to scan crops and livestock."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/android/ic_launcher_monochrome.png",
          "color": "#1C6B38",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/android/ic_launcher_foreground.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0A3720"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow FarmAI to access your location for weather data."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "MSAS FarmAI uses your microphone to convert your spoken questions into text for the AI Farm Assistant."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f06a308-094e-476a-b437-259171d68867"
      }
    },
    "owner": "sanizakka3370"
  }
}
