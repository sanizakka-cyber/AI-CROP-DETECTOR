# ── APPLICATION ───────────────────────────────────────────────────────────────
APP_NAME="MSAS FarmAI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://msasagro.com
APP_TIMEZONE=Africa/Lagos
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── LOGGING ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily,sentry
LOG_LEVEL=error
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# ── SESSION & SECURITY ────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# ── CACHE & QUEUE ─────────────────────────────────────────────────────────────
# Laravel 11 uses CACHE_STORE (not CACHE_DRIVER) — set to redis in production
CACHE_STORE=redis
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ── DATABASE ──────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
# DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD set by Render

# ── REDIS (Render Redis add-on or external) ───────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── MAIL ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@msasagro.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── SENTRY — Error monitoring ─────────────────────────────────────────────────
# Get your DSN from: Sentry project → Settings → Client Keys (DSN)
# Leave blank to disable Sentry (DB error_logs table still active).
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=v1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.20
SENTRY_PROFILES_SAMPLE_RATE=0.10
SENTRY_SEND_DEFAULT_PII=true

# ── AI SERVICES ───────────────────────────────────────────────────────────────
AI_ENGINE_URL=
AI_ENGINE_KEY=
AI_ENV=production

# ── VOICE NARRATION (server TTS) ─────────────────────────────────────────────
# Yoruba/Hausa/Igbo/English — sign up at spitch.app. Leave unset and the app
# falls back to browser speechSynthesis for those languages.
SPITCH_API_KEY=
# SPITCH_BASE_URL=https://api.spitch.app
# French only (Spitch doesn't cover it) — reuses OPENAI_API_KEY if already
# set elsewhere; set OPENAI_TTS_MODEL to override the default model.
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ── CLOUDFLARE R2 (narration audio storage) ──────────────────────────────────
# Render's disk is ephemeral — generated audio needs somewhere persistent.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# ── PAYSTACK ──────────────────────────────────────────────────────────────────
# Never commit real keys — set in Render → Environment Variables
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_ENVIRONMENT=live

# ── SCHEDULER ─────────────────────────────────────────────────────────────────
# Generate with: php artisan key:generate --show | head -c 32
SCHEDULER_KEY=

# ── STORAGE ───────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated production domain(s). Leaving blank denies all cross-origin requests.
CORS_ALLOWED_ORIGINS=https://msasagro.com

# ── SEEDER ────────────────────────────────────────────────────────────────────
# Set before running db:seed. Store the real value in your password manager only.
STAFF_SEED_PASSWORD=

# ── FEATURE FLAGS ─────────────────────────────────────────────────────────────
ENABLE_AUDIT_LOG=true
ENABLE_ERROR_LOG=true
ENABLE_SENTRY=true
ENABLE_QUEUE_MONITORING=true
ENABLE_HEALTH_CHECK=true

# ── VITE ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
