# MSAS FarmAI speech service, CPU image: OpenBible VITS (Hausa; Yoruba and
# Igbo available) and Kokoro-82M (English). Same service code as Dockerfile;
# separate image because coqui-tts and YarnGPT2 need incompatible
# transformers versions. On a 2-thread laptop CPU (bench/): OpenBible first
# Hausa sentence 6-9 s, Kokoro first English sentence about 6 s.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    MODELS_DIR=/models TTS_ENGINES=openbible,kokoro HF_HOME=/models/hf

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg wget ca-certificates espeak-ng \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
COPY requirements.txt requirements-openbible.txt ./
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements.txt -r requirements-openbible.txt

COPY app ./app
COPY fetch_models.sh /usr/local/bin/fetch_models.sh
RUN chmod +x /usr/local/bin/fetch_models.sh \
 && useradd --create-home tts && mkdir -p /models && chown tts /models
USER tts

VOLUME ["/models"]
EXPOSE 8002
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8002/health')"
ENTRYPOINT ["fetch_models.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8002", "--workers", "1"]
