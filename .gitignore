# Dependencies
node_modules/
**/node_modules/

# Build outputs
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example
!.env.sample

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS/editor artifacts
.DS_Store
.vscode/

# Python
__pycache__/
*.py[cod]
*.pyo

# Laravel / PHP — keep pre-built Vite assets committed
!msas-system/public/build/
/vendor/
/storage/app/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*
/public/hot
/public/storage

# Mobile / Expo
.expo/
.android/
.ios/

# Android APKs — distributed via GitHub Releases, not committed
*.apk

# Credentials that must never be committed, even as one-off handover docs —
# security audit found these tracked (KEYSTORE_CREDENTIALS.txt, two
# qa-credentials-*.txt, QA_CREDENTIALS_HANDOVER_GUIDE.md) in a public repo.
# Untracked here; the leaked values still need rotating outside git.
KEYSTORE_CREDENTIALS.txt
**/KEYSTORE_CREDENTIALS.txt
QA_CREDENTIALS_HANDOVER_GUIDE.md
qa-credentials-*.txt
**/qa-credentials-*.txt
